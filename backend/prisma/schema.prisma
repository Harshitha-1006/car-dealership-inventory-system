generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  user
  admin
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(user)
  createdAt DateTime @default(now())
}

model Vehicle {
  id       Int    @id @default(autoincrement())
  make     String
  model    String
  category String
  price    Float
  quantity Int
}
